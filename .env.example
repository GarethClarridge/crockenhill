# Application
APP_ENV=local
APP_NAME="Crockenhill Baptist Church"
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# TRUSTED_PROXIES=*  # Required in production when behind a reverse proxy (Caddy, nginx, etc.)

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crockenhill
DB_USERNAME=sail
DB_PASSWORD=password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Cache & Session (using Redis for dev/prod parity)
CACHE_DRIVER=redis
CACHE_PREFIX=crockenhill_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Mail (Mailpit for local dev, Mailgun for prod)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun (only needed if MAIL_MAILER=mailgun)
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_SIGNING_KEY=
# MAILGUN_TIMESTAMP_TOLERANCE_SECONDS=300
# MAILGUN_ENDPOINT=api.eu.mailgun.net

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Google Calendar
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_JSON=

# OpenAI (only needed if TRANSCRIPTION_SERVICE_TYPE=openai)
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REQUEST_TIMEOUT=600
# OPENAI_MODEL=gpt-4o-mini

# Transcription & Analysis (mock for dev, openai for prod, local for local Whisper)
TRANSCRIPTION_SERVICE_TYPE=mock
TRANSCRIPTION_JOB_TIMEOUT=1800
ANALYSIS_SERVICE=mock
MEDIA_PROCESSING_LIVESTREAM_MAX_FILE_SIZE=8589934592
QUEUE_WORKER_MEMORY=2048

# Local Whisper (only needed if TRANSCRIPTION_SERVICE_TYPE=local)
# Start the whisper container first: docker compose --profile whisper up -d
# LOCAL_WHISPER_URL=http://whisper:8000
# For native whisper.cpp on the Mac host from inside Sail:
# LOCAL_WHISPER_URL=http://host.docker.internal:2022
# LOCAL_WHISPER_TRANSCRIPTION_PATH=/v1/audio/transcriptions
# LOCAL_WHISPER_MODEL=small
# LOCAL_WHISPER_TIMEOUT=1800
# LOCAL_WHISPER_SERIALIZE=true
# LOCAL_WHISPER_LOCK_RELEASE_AFTER=60
# For long historic imports, raise TRANSCRIPTION_JOB_TIMEOUT and queue retry_after together.

# Song matching can keep using CPU faster-whisper for song lyric fallback while
# local sermon/speech transcription points LOCAL_WHISPER_URL at native whisper.cpp.
# This defaults to true only when APP_ENV=local; production should keep using
# the normal OpenAI transcription service for song openings.
# SONG_MATCHING_USE_LOCAL_WHISPER_FOR_OPENINGS=true
# SONG_MATCHING_LOCAL_WHISPER_URL=http://whisper:8000
# SONG_MATCHING_LOCAL_WHISPER_TRANSCRIPTION_PATH=/v1/audio/transcriptions
# SONG_MATCHING_LOCAL_WHISPER_MODEL=small
# SONG_MATCHING_LOCAL_WHISPER_TIMEOUT=1800

# Storage
SERMON_STORAGE_DISK=public

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Notifications
LIVESTREAM_ADMIN_EMAIL=admin@example.org
LIVESTREAM_NOTIFY_SUCCESS=false
LIVESTREAM_NOTIFY_FAILURE=true

# DigitalOcean Spaces (only needed if SERMON_STORAGE_DISK=do_spaces)
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
# DO_SPACES_DEFAULT_REGION=lon1
# DO_SPACES_BUCKET=
# DO_SPACES_ENDPOINT=
# DO_SPACES_CDN_ENDPOINT=

# Speaker Identification (disabled by default)
SPEAKER_IDENTIFICATION_ENABLED=false
SPEAKER_IDENTIFICATION_MODE=shadow
SPEAKER_IDENTIFICATION_PROVIDER=null
SPEAKER_MODEL_VERSION=v1.0
SPEAKER_PYTHON_PATH=python3
SPEAKER_SCRIPT_PATH=scripts/extract_embedding.py

# Google Analytics (production only)
# GOOGLE_ANALYTICS_ID=

# Service tracking
OPENLP_SONGS_DB_PATH=

# API Bible (scripture text enrichment)
API_BIBLE_ENABLED=false
API_BIBLE_KEY=
API_BIBLE_DEFAULT_BIBLE_ID=
# API_BIBLE_BASE_URL=https://api.scripture.api.bible/v1
# API_BIBLE_FUMS_VERSION=3
# API_BIBLE_TIMEOUT_SECONDS=10
# API_BIBLE_MAX_RETRIES=3
# API_BIBLE_REFRESH_AFTER_DAYS=28
# API_BIBLE_DAILY_BUDGET=5000

PIXIAN_ENABLED=false
PIXIAN_API_ID=
PIXIAN_API_SECRET=
# PIXIAN_BASE_URL=https://api.pixian.ai/api/v2
# PIXIAN_TIMEOUT_SECONDS=180
# PIXIAN_TEST=true

# CBC Drive volume mounts (Docker)
# Uncomment and set these when the external CBC drive is connected.
# When unset, Docker uses local stub dirs (./storage/mnt/*) so startup works without the drive.
# CBC_SERVICE_VIDEOS_PATH=/Volumes/CBC drive/ServiceVideos
# CBC_AUDIO_MP3_PATH=/Volumes/CBC drive/CBC Audio/MP3
# CBC_SERVICES_PATH=/Volumes/CBC drive/Documents/Services
