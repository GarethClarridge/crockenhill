APP_ENV=local
APP_DEBUG=true
APP_KEY=OjwM6T6sPnqkHIuFk50GpZ4Jb55DTQJl

DB_HOST=localhost
DB_DATABASE=crockenhill
DB_USERNAME=root
DB_PASSWORD=password

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

# Mail Configuration
# Development (Laravel Sail): Uses Mailpit SMTP (mailpit:1025) - view at http://localhost:8025
# Production: Use Mailgun with credentials below (free tier: 100 emails/day)
MAIL_FROM_ADDRESS=admin@crockenhill.org
MAIL_FROM_NAME="Crockenhill Baptist Church"

# Mailgun Configuration (for production - uncomment these and configure in docker-compose.yml)
# Sign up at https://mailgun.com (free tier: 100 emails/day)
# Get your domain from: https://app.mailgun.com/app/sending/domains
# Get your API key from: https://app.mailgun.com/settings/api_security
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=your-domain.mailgun.org
# MAILGUN_SECRET=your-mailgun-api-key
# MAILGUN_ENDPOINT=api.mailgun.net

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# Google Calendar Integration
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_JSON=

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Automated Sermon Processing
TRANSCRIPTION_SERVICE=openai
TRANSCRIPTION_SERVICE_TYPE=mock  # Use 'openai' for production, 'mock' for local development
ANALYSIS_SERVICE=openai
OPENAI_MODEL=gpt-3.5-turbo
SERMON_PROCESSING_QUEUE=default

# Livestream Video Processing
LIVESTREAM_RMS_THRESHOLD=-30.0
LIVESTREAM_MIN_SECTION_DURATION=60.0
LIVESTREAM_MIN_SERMON_DURATION=300.0
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
LIVESTREAM_MAX_FILE_SIZE=2147483648
LIVESTREAM_STORAGE_DISK=local
LIVESTREAM_SERMON_DISK=local
LIVESTREAM_TEMP_DISK=local
LIVESTREAM_PROCESSING_TIMEOUT=7200
LIVESTREAM_MAX_CONCURRENT_JOBS=2
LIVESTREAM_RETRY_ATTEMPTS=3
LIVESTREAM_RETRY_DELAY=60
LIVESTREAM_ADMIN_EMAIL=admin@crockenhill.org
LIVESTREAM_NOTIFY_SUCCESS=false
LIVESTREAM_NOTIFY_FAILURE=true
LIVESTREAM_TEMP_RETENTION_HOURS=24
LIVESTREAM_FAILED_RETENTION_DAYS=7
LIVESTREAM_AUTO_CLEANUP=true
LIVESTREAM_AUDIO_SAMPLE_RATE=44100
LIVESTREAM_VIDEO_PRESET=medium
LIVESTREAM_PRESERVE_QUALITY=true
LIVESTREAM_DETAILED_LOGGING=true
LIVESTREAM_LOG_FFMPEG=false
LIVESTREAM_PERFORMANCE_MONITORING=true
