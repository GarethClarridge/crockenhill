# Application
APP_ENV=local
APP_NAME="Crockenhill Baptist Church"
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crockenhill
DB_USERNAME=sail
DB_PASSWORD=password

# Cache & Session
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# Mail (Mailpit for local dev)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Google Calendar
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_JSON=

# OpenAI
OPENAI_API_KEY=

# Transcription (mock for dev, openai for prod)
TRANSCRIPTION_SERVICE_TYPE=mock

# Storage
SERMON_STORAGE_DISK=public

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Notifications
LIVESTREAM_ADMIN_EMAIL=admin@example.org
LIVESTREAM_NOTIFY_SUCCESS=false
LIVESTREAM_NOTIFY_FAILURE=true

# DigitalOcean Spaces (for production)
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
# DO_SPACES_DEFAULT_REGION=lon1
# DO_SPACES_BUCKET=
# DO_SPACES_ENDPOINT=
# DO_SPACES_CDN_ENDPOINT=
