# Application
APP_ENV=local
APP_NAME="Crockenhill Baptist Church"
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# TRUSTED_PROXIES=*  # Required in production when behind a reverse proxy (Caddy, nginx, etc.)

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crockenhill
DB_USERNAME=sail
DB_PASSWORD=password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Cache & Session (using Redis for dev/prod parity)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Mail (Mailpit for local dev, Mailgun for prod)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun (only needed if MAIL_MAILER=mailgun)
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_SIGNING_KEY=
# MAILGUN_TIMESTAMP_TOLERANCE_SECONDS=300
# MAILGUN_ENDPOINT=api.eu.mailgun.net

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Google Calendar
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_JSON=

# OpenAI (only needed if TRANSCRIPTION_SERVICE_TYPE=openai)
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REQUEST_TIMEOUT=600
# OPENAI_MODEL=gpt-3.5-turbo

# Transcription & Analysis (mock for dev, openai for prod)
TRANSCRIPTION_SERVICE_TYPE=mock
ANALYSIS_SERVICE=mock

# Storage
SERMON_STORAGE_DISK=public

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Notifications
LIVESTREAM_ADMIN_EMAIL=admin@example.org
LIVESTREAM_NOTIFY_SUCCESS=false
LIVESTREAM_NOTIFY_FAILURE=true

# DigitalOcean Spaces (only needed if SERMON_STORAGE_DISK=do_spaces)
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
# DO_SPACES_DEFAULT_REGION=lon1
# DO_SPACES_BUCKET=
# DO_SPACES_ENDPOINT=
# DO_SPACES_CDN_ENDPOINT=

# Speaker Identification (disabled by default)
SPEAKER_IDENTIFICATION_ENABLED=false
SPEAKER_IDENTIFICATION_MODE=shadow
SPEAKER_IDENTIFICATION_PROVIDER=null
SPEAKER_MODEL_VERSION=v1.0
SPEAKER_PYTHON_PATH=python3
SPEAKER_SCRIPT_PATH=scripts/extract_embedding.py

# Google Analytics (production only)
# GOOGLE_ANALYTICS_ID=

# Service tracking
OPENLP_SONGS_DB_PATH=
