APP_ENV=testing
APP_NAME="Crockenhill Baptist Church"
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database — native MySQL installed via apt
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crockenhill
DB_USERNAME=root
DB_PASSWORD=password

# Redis — native redis-server installed via apt
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Lightweight drivers for CI
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Mail — disabled
MAIL_MAILER=log

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Mock services — no external API keys needed
TRANSCRIPTION_SERVICE_TYPE=mock
ANALYSIS_SERVICE=mock

# Storage — local only
SERMON_STORAGE_DISK=public
PROCESSING_PERMANENT_DISK=local
PROCESSING_TEMP_DISK=local

# FFmpeg (preinstalled on Jules VM via setup script)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Notifications — disabled
LIVESTREAM_ADMIN_EMAIL=admin@example.org
LIVESTREAM_NOTIFY_SUCCESS=false
LIVESTREAM_NOTIFY_FAILURE=false

# Speaker identification — disabled
SPEAKER_IDENTIFICATION_ENABLED=false
