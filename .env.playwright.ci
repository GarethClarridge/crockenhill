APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Debugbar's JS pads <body> by its bar height (~33px) after init; the visual-test
# CSS hides the bar so recalculations race between 0 and 33px, oscillating the
# page height and breaking screenshot stability. Disable injection entirely.
DEBUGBAR_ENABLED=false
LOG_CHANNEL=stderr
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=testing_pw
DB_USERNAME=root
DB_PASSWORD=testing
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
TRANSCRIPTION_SERVICE_TYPE=mock
ANALYSIS_SERVICE=mock
SERMON_STORAGE_DISK=public
PLAYWRIGHT_SEED=12345
PLAYWRIGHT_NOW="2026-05-26 12:00:00"
