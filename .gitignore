# Dependencies
/node_modules
/vendor
/bower_components

# Environment files
.env
.env.*
!.env.example
!.env.dusk.ci

# IDE and editor files
/.idea
.DS_Store

# Laravel storage
/storage/*
!/storage/app/.gitignore
!/storage/framework/.gitignore
!/storage/logs/.gitignore

# Laravel compiled/generated
/public/hot
/public/css/filament
/public/js/filament
/public/vendor
/public/sitemap.xml

# Public assets (uploaded media only)
/public/media
/public/scripts
/public/styles

# Test and cache files
.phpunit.result.cache
/.phpunit.cache/
*.cache
*.backup

# Lock files
composer.lock
package-lock.json

# Homestead
Homestead.json
Homestead.yaml

# Media files (except test fixtures)
*.mp3
*.mp4
!/tests/Integration/fixtures/*.mp4

# Logs
artisan_serve.log
*.log

# Example files
*.osz
*.sqlite