<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="bootstrap/app.php"
         defaultTestSuite="Default Tests"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
         backupGlobals="false"
         backupStaticProperties="false">
    <testsuites>
        <testsuite name="Default Tests">
            <directory suffix="Test.php">./tests/Feature</directory>
            <directory suffix="Test.php">./tests/Integration</directory>
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>

        <testsuite name="Feature Tests">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>

        <testsuite name="Unit Tests">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>

        <testsuite name="Integration Tests">
            <directory suffix="Test.php">./tests/Integration</directory>
        </testsuite>

        <testsuite name="Browser Tests">
            <directory suffix="Test.php">./tests/Browser</directory>
        </testsuite>

        <testsuite name="Performance Tests">
            <directory suffix="Test.php">./tests/Performance</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="CACHE_PREFIX" value="test_process"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="LOG_CHANNEL" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="TRANSCRIPTION_MAX_RETRIES" value="1"/>
        <env name="TRANSCRIPTION_RETRY_DELAY_BASE" value="0"/>
        <env name="OPENAI_API_KEY" value="testy-test-key"/>
        <env name="OPENAI_BASE_URL" value="http://127.0.0.1:1/v1"/>

        <!-- Storage Configuration for Tests -->
        <env name="DO_SPACES_ACCESS_KEY_ID" value="test_access_key"/>
        <env name="DO_SPACES_SECRET_ACCESS_KEY" value="test_secret_key"/>
        <env name="DO_SPACES_DEFAULT_REGION" value="nyc3"/>
        <env name="DO_SPACES_BUCKET" value="test_bucket"/>
        <!-- Refused-connection endpoint: a wrong S3 fallback errors in ms instead
             of blocking ~12 s on a real DigitalOcean Spaces TCP timeout. Mirrors
             the OPENAI_BASE_URL trick above. DO_SPACES_RETRIES=0 stops the AWS SDK
             retrying the refused connection with backoff. -->
        <env name="DO_SPACES_ENDPOINT" value="http://127.0.0.1:1"/>
        <env name="DO_SPACES_CDN_ENDPOINT" value="https://test.nyc3.cdn.digitaloceanspaces.com"/>
        <env name="DO_SPACES_RETRIES" value="0"/>

        <!-- Processing Configuration -->
        <env name="PROCESSING_PERMANENT_DISK" value="local"/>
        <env name="PROCESSING_TEMP_DISK" value="local"/>
        <env name="SERMON_STORAGE_DISK" value="public"/>
        <!--
            The public service archive fails closed without a cutoff. An early
            bound is the "no lower bound" baseline every test that is not about
            the boundary itself expects; the boundary's own tests override it.
        -->
        <env name="CHURCH_SERVICES_PUBLIC_FROM" value="1980-01-01"/>
        <env name="LIVESTREAM_STORAGE_DISK" value="local"/>
        <env name="LIVESTREAM_SERMON_DISK" value="public"/>
        <env name="LEGACY_SERMON_DISK" value="public"/>

        <!-- Transcription Configuration -->
        <env name="TRANSCRIPTION_SERVICE_TYPE" value="mock"/>
    </php>
</phpunit>
