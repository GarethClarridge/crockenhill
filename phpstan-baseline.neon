			message: '#^Parameter \#1 \$num of function round expects float\|int, bool\|string given\.$#'
			identifier: argument.type
			count: 2
			path: app/Jobs/ExtractSermon.php

		-
			message: '#^Parameter \#2 \$songClusters of method App\\Jobs\\PerformVisualAnalysis\:\:storeVisualAnalysis\(\) expects array\<string, mixed\>, array\<int, array\<string, array\<int, float\>\|float\|int\>\> given\.$#'
			identifier: argument.type
			count: 2
			path: app/Jobs/PerformVisualAnalysis.php

		-
			message: '#^Method App\\Services\\VideoExtractionService\:\:extractOptimizedAudio\(\) should return array\<string, bool\|string\> but returns array\<string, bool\|float\|int\|string\>\.$#'
			identifier: return.type
			count: 1
			path: app/Services/VideoExtractionService.php

		-
			message: '#^Method App\\Services\\VideoExtractionService\:\:getProcessingOutputPath\(\) should return array\<string, string\> but returns array\<string, string\|false\>\.$#'
			identifier: return.type
			count: 1
			path: app/Services/VideoExtractionService.php

		-
			message: '#^Method App\\Services\\VideoExtractionService\:\:getProcessingOutputPath\(\) should return array\<string, string\> but returns array\<string, string\|true\>\.$#'
			identifier: return.type
			count: 1
			path: app/Services/VideoExtractionService.php

		-
			message: '#^Comparison operation "\>" between float and \(array\|float\|int\) results in an error\.$#'
			identifier: greater.invalid
			count: 1
			path: app/Services/VideoSegmentationService.php

