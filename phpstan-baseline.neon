			identifier: return.type
			count: 1
			path: app/Jobs/AnalyzeSegments.php

		-
			message: '#^Method App\\Jobs\\AnalyzeSegments\:\:findSermonCandidate\(\) never returns App\\Data\\LivestreamSegment so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: app/Jobs/AnalyzeSegments.php

		-
			message: '#^Method App\\Jobs\\AnalyzeSegments\:\:findSermonCandidate\(\) should return App\\Data\\LivestreamSegment\|null but returns App\\Models\\LivestreamSegment\.$#'
			identifier: return.type
			count: 1
			path: app/Jobs/AnalyzeSegments.php

		-
			message: '#^Method App\\Jobs\\AnalyzeSegments\:\:getVisualClusters\(\) never returns array\<string, mixed\> so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: app/Jobs/AnalyzeSegments.php

		-
			message: '#^Method App\\Jobs\\AnalyzeSegments\:\:getVisualClusters\(\) should return array\<string, mixed\>\|null but returns array\<int, array\<string, mixed\>\>\|null\.$#'
			identifier: return.type
			count: 1
			path: app/Jobs/AnalyzeSegments.php

		-
			message: '#^Parameter \#1 \$num of function round expects float\|int, bool\|string given\.$#'
			identifier: argument.type
			count: 1
			path: app/Jobs/ExtractAudioFromVideo.php

