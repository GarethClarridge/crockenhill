{
    "name": "crockenhill/crockenhill",
    "description": "The Crockenhill Baptist Church website.",
    "keywords": [
        "crockenhill",
        "baptist",
        "church",
        "website",
        "laravel"
    ],
    "license": "MIT",
    "homepage": "https://crockenhill.org",
    "type": "project",
    "require": {
        "php": "^8.4",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "intervention/image-laravel": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.47",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.2",
        "league/flysystem-aws-s3-v3": "^3.29",
        "livewire/livewire": "^4.0",
        "openai-php/laravel": "^0.19.0",
        "owen-oj/laravel-getid3": "^2.2",
        "php-ffmpeg/php-ffmpeg": "^1.3",
        "predis/predis": "^3.1",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-data": "^4.17",
        "spatie/laravel-google-calendar": "^3.8",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-schedule-monitor": "^4.3",
        "spatie/laravel-sitemap": "^8.0",
        "symfony/http-client": "^7.3",
        "symfony/mailgun-mailer": "^7.3",
        "techwilk/bible-verse-parser": "~2.8.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "brianium/paratest": "^7.22",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.5",
        "laravel/boost": "^2.1",
        "laravel/dusk": "^8.3",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.23",
        "laravel/sail": "^1.43",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^13.0",
        "spatie/guidelines-skills": "dev-main"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "phpstan": [
            "./vendor/bin/phpstan analyse"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
