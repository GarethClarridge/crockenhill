APP_ENV=local
APP_KEY=
APP_URL=http://host-docker-internal:8000
DUSK_DRIVER_URL=http://localhost:4444/wd/hub
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=testing_dusk
DB_USERNAME=root
DB_PASSWORD=testing
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
TRANSCRIPTION_SERVICE_TYPE=mock
ANALYSIS_SERVICE=mock
SERMON_STORAGE_DISK=public
# Without a cutoff the public service archive is empty, so browser tests would
# assert against a blank page rather than the boundary they mean to check.
CHURCH_SERVICES_PUBLIC_FROM=1980-01-01
